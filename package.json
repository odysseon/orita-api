{
  "name": "orita",
  "version": "0.0.0",
  "private": true,
  "description": "Orita — local discovery platform connecting people with businesses, services, and opportunities around them.",
  "license": "ISC",
  "author": "Hammed Anuoluwapo Pelumi",
  "type": "module",
  "scripts": {
    "db:seed": "tsx prisma/seed.ts",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"**/*.md\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "migrate": "prisma migrate dev --name",
    "migrate:prod": "prisma migrate deploy",
    "generate": "prisma generate",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "typefix": "tsc --noEmit --fix",
    "test": "vitest run",
    "test:cov": "echo \"TODO: Add coverage test runner\" && exit 0",
    "test:debug": "echo \"TODO: Add debug test runner\" && exit 0",
    "test:e2e": "echo \"TODO: Add e2e test runner\" && exit 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/lib-storage": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@neondatabase/serverless": "^1.1.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@odysseon/whoami-adapter-argon2": "^16.0.0",
    "@odysseon/whoami-adapter-jose": "^16.0.0",
    "@odysseon/whoami-adapter-nestjs": "^16.0.0",
    "@odysseon/whoami-adapter-prisma": "^3.0.0",
    "@odysseon/whoami-adapter-webcrypto": "^13.0.0",
    "@odysseon/whoami-core": "^13.1.0",
    "@prisma/adapter-neon": "^7.9.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "google-auth-library": "^10.9.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.13.9",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "posthog-node": "^5.46.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/streamifier": "^0.1.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.0.0",
      "onFail": "error"
    }
  }
}
