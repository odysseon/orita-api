generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model Account {
  id             String               @id @default(cuid())
  email          String               @unique
  sessionVersion Int                  @default(1)
  createdAt      DateTime             @default(now())
  magicLinks     MagicLinkToken[]
  oauthCreds     OAuthCredential[]
  passwordHash   PasswordHash?
  resetTokens    PasswordResetToken[]
  user           User?
  sessions       Session[]
}

model Session {
  id               String    @id @default(cuid())
  accountId        String
  refreshTokenHash String
  deviceName       String?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordHash {
  id        String   @id @default(cuid())
  accountId String   @unique
  hash      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("password_hashes")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([accountId])
  @@map("password_reset_tokens")
}

model OAuthCredential {
  id         String   @id @default(cuid())
  accountId  String
  provider   String
  providerId String
  createdAt  DateTime @default(now())
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([accountId])
  @@map("oauth_credentials")
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([accountId])
  @@map("magic_link_tokens")
}

enum UserStatus {
  ACTIVE
  PENDING_DELETION
}

model User {
  id                      String                   @id @default(cuid())
  accountId               String                   @unique
  username                String                   @unique
  displayName             String?
  bio                     String?
  role                    PlatformRole             @default(USER)
  status                  UserStatus               @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  activeExplorationLat    Float?
  activeExplorationLng    Float?
  activeExplorationName   String?
  inAppNotifications      InAppNotification[]
  notificationPreferences NotificationPreference?
  businessFollows         BusinessFollow[]         @relation("BusinessFollows")
  businessProfile         BusinessProfile?
  businessToursCreated    BusinessTour[]
  businessVerifications   BusinessVerification[]
  locationFollows         LocationFollow[]         @relation("LocationFollows")
  participant             Participant?
  reviewsGiven            Review[]                 @relation("ReviewsGiven")
  savedListings           SavedListing[]           @relation("SavedListings")
  uploadIntents           UploadIntent[]
  pushSubscriptions       PushSubscription[]
  media                   Media[]
  following               UserFollow[]             @relation("UserFollowing")
  followers               UserFollow[]             @relation("UserFollowers")
  interestedCategories    UserInterestedCategory[]
  sharesSent              ItemShare[]              @relation("SentShares")
  sharesReceived          ItemShare[]              @relation("ReceivedShares")
  opportunityPosts        OpportunityPost[]
  account                 Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("users")
}

model BusinessVerification {
  id              String                         @id @default(cuid())
  businessId      String                         @unique
  status          VerificationStatus             @default(PENDING)
  submittedAt     DateTime                       @default(now())
  reviewedAt      DateTime?
  rejectionReason String?
  reviewedById    String?
  updatedAt       DateTime                       @updatedAt
  documents       BusinessVerificationDocument[]
  business        BusinessProfile                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewer        User?                          @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("business_verifications")
}

model BusinessVerificationDocument {
  id                     String                           @id @default(cuid())
  businessVerificationId String
  storageKey             String
  mimeType               String
  createdAt              DateTime                         @default(now())
  checksum               String?
  fileSize               Int?
  rejectionReason        String?
  status                 VerificationStatus               @default(PENDING)
  storageProvider        String
  type                   BusinessVerificationDocumentType
  businessVerification   BusinessVerification             @relation(fields: [businessVerificationId], references: [id], onDelete: Cascade)

  @@index([businessVerificationId])
  @@map("business_verification_documents")
}

model BusinessProfile {
  id                  String                @id @default(cuid())
  ownerId             String                @unique
  name                String
  slug                String                @unique
  isPublic            Boolean               @default(false)
  description         String?
  whatsapp            String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  locationId          String?
  businessType        BusinessType          @default(ONLINE)
  websiteUrl          String?
  contactEmail        String?
  contactPhone        String?
  analyticsEvents     AnalyticsEvent[]
  categories          BusinessCategory[]    @relation("BusinessCategories")
  followers           BusinessFollow[]
  tags                BusinessProfileTag[]
  geoEntity           Location?             @relation(fields: [locationId], references: [id])
  owner               User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessTours       BusinessTour[]
  verification        BusinessVerification?
  conversationAnchors ConversationAnchor[]
  discoveryItems      DiscoveryItem[]
  listings            Listing[]
  media               Media[]
  hours               OperatingHours[]
  participant         Participant?
  opportunityPosts    OpportunityPost[]
  serviceModes        BusinessServiceMode[]
  serviceAreas        BusinessServiceArea[]

  @@index([slug])
  @@index([isPublic])
  @@index([locationId])
  @@map("business_profiles")
}

model Location {
  id                  String                  @id @default(cuid())
  externalId          String?
  provider            String
  name                String
  formattedAddress    String?
  searchText          String?
  countryCode         String?
  latitude            Float
  longitude           Float
  coordinates         Unsupported("geometry")
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  businessProfiles    BusinessProfile[]
  conversationAnchors ConversationAnchor[]
  followers           LocationFollow[]
  opportunityPosts    OpportunityPost[]

  @@unique([provider, externalId])
  @@map("locations")
}

model Listing {
  id                  String               @id @default(cuid())
  businessProfileId   String
  title               String
  slug                String
  description         String?
  status              ListingStatus        @default(DRAFT)
  minPrice            Decimal?             @db.Decimal(18, 2)
  maxPrice            Decimal?             @db.Decimal(18, 2)
  isNegotiable        Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  categoryId          String?
  currencyCode        String?
  attributes          Json?
  availability        ListingAvailability  @default(IN_STOCK)
  conversationAnchors ConversationAnchor[]
  businessProfile     BusinessProfile      @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  category            Category?            @relation("ListingCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  media               Media[]
  reviews             Review[]
  savedByUsers        SavedListing[]       @relation("SavedByUsers")
  serviceAreas        ListingServiceArea[]

  @@unique([businessProfileId, slug])
  @@index([businessProfileId])
  @@index([status])
  @@index([currencyCode])
  @@index([minPrice])
  @@index([maxPrice])
  @@index([isNegotiable])
  @@index([categoryId])
  @@map("listings")
}

model Media {
  id                String           @id @default(cuid())
  fileId            String           @unique
  mediaType         MediaType
  role              MediaRole
  order             Int?
  createdAt         DateTime         @default(now())
  businessProfileId String?
  listingId         String?
  businessTourId    String?
  reviewId          String?
  userId            String?
  messageId         String?
  opportunityPostId String?
  uploadIntentId    String?
  bytes             Int?
  duration          Float?
  format            String?
  height            Int?
  mimeType          String
  provider          StorageProvider
  version           String?
  width             Int?
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  businessTour      BusinessTour?    @relation(fields: [businessTourId], references: [id], onDelete: Cascade)
  listing           Listing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  review            Review?          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user              User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  message           Message?         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  opportunityPost   OpportunityPost? @relation(fields: [opportunityPostId], references: [id], onDelete: Cascade)
  uploadIntent      UploadIntent?    @relation(fields: [uploadIntentId], references: [id], onDelete: SetNull)

  @@index([businessProfileId])
  @@index([listingId])
  @@index([businessTourId])
  @@index([opportunityPostId])
  @@map("media")
}

model UploadIntent {
  id          String          @id @default(cuid())
  ownerType   UploadOwnerType
  ownerId     String
  role        MediaRole
  provider    StorageProvider
  folder      String
  publicId    String
  createdById String
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
  consumedAt  DateTime?
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  media       Media[]

  @@index([ownerId])
  @@index([createdById])
  @@map("upload_intents")
}

model BusinessCategory {
  businessId String
  categoryId String
  isPrimary  Boolean         @default(false)
  business   BusinessProfile @relation("BusinessCategories", fields: [businessId], references: [id], onDelete: Cascade)
  category   Category        @relation("BusinessCategories", fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@index([businessId])
  @@index([categoryId])
  @@map("business_categories")
}

model Category {
  id               String                   @id @default(cuid())
  name             String
  slug             String                   @unique
  description      String?
  parentId         String?
  order            Int                      @default(0)
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  businessProfiles BusinessCategory[]       @relation("BusinessCategories")
  parent           Category?                @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[]               @relation("CategoryTree")
  attributes       CategoryAttribute[]
  discoveryPolicy  CategoryDiscoveryPolicy?
  listings         Listing[]                @relation("ListingCategory")
  interestedUsers  UserInterestedCategory[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model UserInterestedCategory {
  userId     String
  categoryId String
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
  @@map("user_interested_categories")
}

model CategoryDiscoveryPolicy {
  categoryId           String   @id
  feedRadiusKm         Int      @default(15)
  notificationRadiusKm Int      @default(5)
  searchRadiusKm       Int      @default(10)
  category             Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_discovery_policies")
}

model CategoryAttribute {
  id           String        @id @default(cuid())
  categoryId   String
  key          String
  label        String
  type         AttributeType
  isRequired   Boolean       @default(false)
  displayOrder Int           @default(0)
  options      Json?
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@index([categoryId])
  @@map("category_attributes")
}

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  listingId  String
  media      Media[]
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([listingId, reviewerId])
  @@index([reviewerId])
  @@index([listingId])
  @@map("reviews")
}

model BusinessTour {
  id                  String                  @id @default(cuid())
  businessProfileId   String
  title               String
  summary             String?
  visitDate           DateTime
  status              BusinessTourStatus      @default(DRAFT)
  publishedAt         DateTime?
  createdById         String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  highlights          BusinessTourHighlight[]
  businessProfile     BusinessProfile         @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  createdBy           User                    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  conversationAnchors ConversationAnchor[]
  media               Media[]

  @@index([businessProfileId])
  @@index([status])
  @@map("business_tours")
}

model BusinessTourHighlight {
  id             String       @id @default(cuid())
  businessTourId String
  value          String
  businessTour   BusinessTour @relation(fields: [businessTourId], references: [id], onDelete: Cascade)

  @@index([businessTourId])
  @@map("business_tour_highlights")
}

model Tag {
  id         String               @id @default(cuid())
  name       String               @unique
  slug       String               @unique
  businesses BusinessProfileTag[]

  @@map("tags")
}

model BusinessProfileTag {
  businessProfileId String
  tagId             String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  tag               Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([businessProfileId, tagId])
  @@map("business_profile_tags")
}

model OperatingHours {
  id                String          @id @default(cuid())
  businessProfileId String
  day               DayOfWeek
  openTime          String
  closeTime         String
  isClosed          Boolean         @default(false)
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@unique([businessProfileId, day])
  @@index([businessProfileId])
  @@map("operating_hours")
}

model Participant {
  id                       String                    @id @default(cuid())
  userId                   String?                   @unique
  businessProfileId        String?                   @unique
  conversationParticipants ConversationParticipant[]
  readReceipts             MessageReadReceipt[]
  messagesSent             Message[]
  business                 BusinessProfile?          @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  user                     User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("participants")
}

model ConversationAnchor {
  id           String           @id @default(cuid())
  businessId   String?
  listingId    String?
  tourId        String?
  locationId    String?
  opportunityId String?
  title         String
  subtitle      String?
  imageUrl      String?
  business      BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  listing       Listing?         @relation(fields: [listingId], references: [id], onDelete: SetNull)
  location      Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tour          BusinessTour?    @relation(fields: [tourId], references: [id], onDelete: SetNull)
  opportunity   OpportunityPost? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  conversation  Conversation?

  @@map("conversation_anchors")
}

model Conversation {
  id           String                    @id @default(cuid())
  status       ConversationStatus        @default(ACTIVE)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  anchorId     String?                   @unique
  title        String?
  type         ConversationType          @default(DIRECT)
  participants ConversationParticipant[]
  anchor       ConversationAnchor?       @relation(fields: [anchorId], references: [id])
  messages     Message[]

  @@index([status])
  @@index([type])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  joinedAt       DateTime                    @default(now())
  lastReadAt     DateTime                    @default(now())
  participantId  String
  role           ConversationParticipantRole @default(MEMBER)
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participant    Participant                 @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([conversationId, participantId])
  @@index([participantId])
  @@map("conversation_participants")
}

model Message {
  id                String               @id @default(cuid())
  conversationId    String
  content           String?
  mediaUrl          String?
  mediaType         MediaType?
  createdAt         DateTime             @default(now())
  participantId     String
  senderAvatarUrl   String?
  senderDisplayName String
  embeds            MessageEmbed[]
  readReceipts      MessageReadReceipt[]
  conversation      Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participant       Participant          @relation(fields: [participantId], references: [id], onDelete: Cascade)
  media             Media[]

  @@index([conversationId, createdAt])
  @@index([participantId])
  @@map("messages")
}

model MessageEmbed {
  id        String           @id @default(cuid())
  messageId String
  targetId  String
  title     String
  subtitle  String?
  imageUrl  String?
  ctaLabel  String?
  ctaPath   String?
  createdAt DateTime         @default(now())
  embedType MessageEmbedType
  message   Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_embeds")
}

model MessageReadReceipt {
  messageId     String
  readAt        DateTime    @default(now())
  participantId String
  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([messageId, participantId])
  @@index([participantId])
  @@map("message_read_receipts")
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  listing   Listing  @relation("SavedByUsers", fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation("SavedListings", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("saved_listings")
}

model BusinessFollow {
  id                   String          @id @default(cuid())
  userId               String
  businessId           String
  notificationsEnabled Boolean         @default(true)
  createdAt            DateTime        @default(now())
  business             BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                 User            @relation("BusinessFollows", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@map("business_follows")
}

model LocationFollow {
  id                   String   @id @default(cuid())
  userId               String
  locationId           String
  notificationsEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  location             Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user                 User     @relation("LocationFollows", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
  @@map("location_follows")
}

model UserFollow {
  id                   String   @id @default(cuid())
  followerId           String
  followingId          String
  notificationsEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  follower             User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following            User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("user_follows")
}

model AnalyticsEvent {
  id                String             @id @default(cuid())
  businessProfileId String
  eventType         AnalyticsEventType
  listingId         String?
  userId            String?
  createdAt         DateTime           @default(now())
  businessProfile   BusinessProfile    @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@index([businessProfileId])
  @@index([eventType])
  @@index([createdAt])
  @@map("analytics_events")
}

model ItemShare {
  id             String           @id @default(cuid())
  senderId       String
  sender         User             @relation("SentShares", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      User             @relation("ReceivedShares", fields: [recipientId], references: [id], onDelete: Cascade)
  embedType      MessageEmbedType
  targetId       String
  conversationId String?
  createdAt      DateTime         @default(now())

  @@index([embedType, targetId])
  @@index([senderId, recipientId, targetId, createdAt])
  @@map("item_shares")
}

model DiscoveryItem {
  id                String            @id @default(cuid())
  itemType          DiscoveryItemType
  businessProfileId String
  referenceId       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  clicksCount       Int               @default(0)
  hidesCount        Int               @default(0)
  messagesCount     Int               @default(0)
  reportsCount      Int               @default(0)
  savesCount        Int               @default(0)
  sharesCount       Int               @default(0)
  businessProfile   BusinessProfile   @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@unique([itemType, referenceId])
  @@index([businessProfileId])
  @@map("discovery_items")
}

model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  messages          Boolean  @default(true)
  nearbyDiscoveries Boolean  @default(true)
  following         Boolean  @default(true)
  security          Boolean  @default(true)
  marketing         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InAppNotification {
  id            String               @id @default(cuid())
  userId        String
  category      NotificationCategory @default(SYSTEM)
  type          String
  actorId       String?
  referenceType String?
  referenceId   String?
  payload       Json                 @default("{}")
  readAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  platform   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum PlatformRole {
  USER
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessVerificationDocumentType {
  CAC_CERTIFICATE
  CAC_STATUS_REPORT
  GOVERNMENT_ID
  SELFIE
  PROOF_OF_ADDRESS
  OTHER
}

enum BusinessType {
  ONLINE
  PHYSICAL
  HYBRID
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum ListingAvailability {
  IN_STOCK
  OUT_OF_STOCK
  PRE_ORDER
}

enum StorageProvider {
  CLOUDINARY
  BACKBLAZE
}

enum UploadOwnerType {
  BUSINESS_PROFILE
  LISTING
  BUSINESS_TOUR
  REVIEW
  USER
  OPPORTUNITY_POST
  CONVERSATION
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaRole {
  /// BusinessProfile only — singleton
  LOGO
  /// BusinessProfile only — singleton
  BANNER
  /// Listing only — singleton
  COVER
  /// Both resource types — reorderable multi-items
  GALLERY
  /// User profile avatar
  AVATAR
  /// Messaging attachments
  MESSAGE
}

enum AttributeType {
  STRING
  NUMBER
  BOOLEAN
  SELECT
}

enum BusinessTourStatus {
  DRAFT
  PUBLISHED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationStatus {
  ACTIVE
  CLOSED
}

enum ConversationParticipantRole {
  OWNER
  MEMBER
}

enum MessageEmbedType {
  BUSINESS
  LISTING
  TOUR
  LOCATION
  OPPORTUNITY
}

enum AnalyticsEventType {
  PROFILE_VIEW
  LISTING_VIEW
  PHONE_CLICK
  WEBSITE_CLICK
  DIRECTIONS_CLICK
}

enum DiscoveryItemType {
  BUSINESS
  LISTING
  TOUR
  PROMOTION
}

enum NotificationCategory {
  SOCIAL
  BUSINESS
  LISTING
  REVIEW
  SYSTEM
}

model OpportunityPost {
  id                String            @id @default(cuid())
  authorId          String
  businessProfileId String?
  title             String
  body              String?
  type              OpportunityType
  locationId        String
  expiresAt         DateTime?
  status            OpportunityStatus @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  deletedBy         String?

  author              User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  businessProfile     BusinessProfile?     @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)
  location            Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  media               Media[]
  conversationAnchors ConversationAnchor[]

  @@index([status, expiresAt])
  @@index([authorId])
  @@index([locationId])
  @@map("opportunity_posts")
}

enum OpportunityType {
  FOR_SALE
  FREE
  WANTED
  BORROW_LEND
  TEMP_SERVICE
  LOST_FOUND
}

enum OpportunityStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  DELETED
}

enum ServiceAreaType {
  INHERIT
  RADIUS
  POLYGON
  ADMIN_REGION
  NATIONWIDE
  REMOTE
}

enum ServiceMode {
  AT_LOCATION
  MOBILE
  REMOTE
  DELIVERY
  PICKUP
}

model AdministrativeRegion {
  id                   String                 @id @default(cuid())
  code                 String                 @unique
  name                 String
  type                 String
  level                Int
  countryCode          String
  parentId             String?
  parent               AdministrativeRegion?  @relation("RegionHierarchy", fields: [parentId], references: [id])
  children             AdministrativeRegion[] @relation("RegionHierarchy")
  businessServiceAreas BusinessServiceArea[]
  listingServiceAreas  ListingServiceArea[]

  @@map("administrative_regions")
}

model BusinessServiceMode {
  id                String          @id @default(cuid())
  businessProfileId String
  mode              ServiceMode
  createdAt         DateTime        @default(now())
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@unique([businessProfileId, mode])
  @@map("business_service_modes")
}

model BusinessServiceArea {
  id                     String                                      @id @default(cuid())
  businessProfileId      String
  name                   String?
  type                   ServiceAreaType
  administrativeRegionId String?
  administrativeRegion   AdministrativeRegion?                       @relation(fields: [administrativeRegionId], references: [id])
  radiusKm               Int?
  centerGeography        Unsupported("geography(Point,4326)")?
  polygonGeometry        Unsupported("geometry(MultiPolygon,4326)")?
  displayOrder           Int                                         @default(0)
  enabled                Boolean                                     @default(true)
  createdAt              DateTime                                    @default(now())
  updatedAt              DateTime                                    @updatedAt
  businessProfile        BusinessProfile                             @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@index([businessProfileId])
  @@map("business_service_areas")
}

model ListingServiceArea {
  id                     String                                      @id @default(cuid())
  listingId              String
  name                   String?
  type                   ServiceAreaType                             @default(INHERIT)
  administrativeRegionId String?
  administrativeRegion   AdministrativeRegion?                       @relation(fields: [administrativeRegionId], references: [id])
  radiusKm               Int?
  centerGeography        Unsupported("geography(Point,4326)")?
  polygonGeometry        Unsupported("geometry(MultiPolygon,4326)")?
  displayOrder           Int                                         @default(0)
  enabled                Boolean                                     @default(true)
  createdAt              DateTime                                    @default(now())
  updatedAt              DateTime                                    @updatedAt
  listing                Listing                                     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_service_areas")
}
